DATABASE_URL=postgresql://payload:payload@localhost:5432/bodywork
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# The hub's own URL: the bare host, one screen routing to Centrum/Akademia/Alfabet Ruchu.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://dash.localhost:3000
# Centrum's own URL, read by pageMetadata/sitemap/structured data: keep in sync with CENTRUM_HOST.
NEXT_PUBLIC_CENTRUM_URL=http://centrum.localhost:3000
DASHBOARD_HOST=dash.localhost
CENTRUM_HOST=centrum.localhost
# Host port for the dev Postgres container; change if 5432 is already taken.
POSTGRES_PORT=5432

# --- Deployment only, leave both empty in dev ---
# Extra trusted origins beyond NEXT_PUBLIC_SERVER_URL and NEXT_PUBLIC_DASHBOARD_URL,
# comma separated, full URLs. Needed when the app answers on more than one public
# host; without it a POST from the unnamed host fails CSRF. Feeds Payload's csrf/cors
# and Next's serverActions.allowedOrigins.
PAYLOAD_EXTRA_ORIGINS=

# --- Email (Resend) ---
# Leave RESEND_API_KEY empty in dev: mail is then printed to the server console instead of
# sent, and the whole newsletter double opt-in still works end to end.
# Sending from a body-work.pl address requires verifying the domain in Resend first (DKIM +
# SPF records on Cloudflare). Until that is done, only `onboarding@resend.dev` will send,
# and only to the address that owns the Resend account.
RESEND_API_KEY=
EMAIL_FROM=BODYWORK <newsletter@body-work.pl>

# --- Admin AI (Google Gemini) ---
# Free key from Google AI Studio. Leave empty to disable AI buttons in the admin.
# Free-tier prompts may be used by Google to improve models; do not send secrets/PII.
GEMINI_API_KEY=
